{
  "name": "authyon",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --workspaces --dry-run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run docs && npm run pack:check",
    "release:check": "npm run check && npm audit --omit=dev",
    "docs": "typedoc",
    "publish:auth": "npm publish --workspace @authyon/auth --access public",
    "publish:server": "npm publish --workspace @authyon/server --access public"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "redis": "^6.2.1",
    "semver": "^7.8.5",
    "typedoc": "^0.26.11",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}

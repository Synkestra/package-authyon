{
  "name": "@authyon/server",
  "version": "0.2.0-beta.3",
  "description": "Authyon SDK for backends — server-to-server organization/member management and access-token verification.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synkestra/package-authyon.git",
    "directory": "packages/server"
  },
  "homepage": "https://authyon.com/docs",
  "bugs": {
    "url": "https://github.com/Synkestra/package-authyon/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "authyon",
    "auth",
    "server-to-server",
    "management-api",
    "tokenVerification"
  ],
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "jose": "^6.2.10"
  }
}
